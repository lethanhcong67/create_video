# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional API key for gpt-image-2 OpenAI image generation.
OPENAI_API_KEY=""

# KLINGAI_API_KEY: Optional API key for Kling AI video generation.
KLINGAI_API_KEY=""

# VISION_API_KEY: Optional dedicated key for the Gemini/OpenLux vision analysis calls.
# Falls back to GEMINI_API_KEY when not set.
VISION_API_KEY=""

# OPENLUX_API_KEY: Default OpenLux AI gateway key used for gpt-image-2 / Gemini-via-OpenLux calls
# when the client does not supply its own key.
OPENLUX_API_KEY=""

# MNAPI_API_KEY: Fallback image-edit provider key used when OpenLux is unavailable.
MNAPI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
